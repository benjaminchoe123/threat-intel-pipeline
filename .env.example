# abuse.ch Auth-Key — required for URLhaus and ThreatFox ingestion.
# Register free at https://auth.abuse.ch (pipeline runs KEV + MTA RSS without it).
# Note: abuse.ch answers HTTP 200 with query_status=illegal_auth_key on a bad key;
# the pipeline detects that and fails loudly rather than reporting a quiet day.
ABUSECH_AUTH_KEY=

# VirusTotal API key — enables live IOC reputation lookups during enrichment.
# Register free at https://www.virustotal.com (free tier: 4 lookups/min, 500/day).
# Pipeline runs without it; notes just lack the VirusTotal section.
VT_API_KEY=

# AbuseIPDB API key — adds community abuse-report scores for IP IOCs.
# Register free at https://www.abuseipdb.com (free tier: 1,000 checks/day).
ABUSEIPDB_API_KEY=

# GreyNoise Community API key — says whether an IP is mass-scanning the internet
# or is dedicated infrastructure, and names benign scanners (Shodan, Censys).
# Register free at https://www.greynoise.io/plans (Community tier).
GREYNOISE_API_KEY=

# EPSS (exploitation probability for CVEs) needs no key and is always on.

# --- Tunables (optional; defaults shown) ---
# Days of feed history to consider for KEV and MTA.
# LOOKBACK_DAYS=7
# Max enrichments per run. Un-enriched items carry over to the next run.
# MAX_ENRICH_PER_RUN=15
