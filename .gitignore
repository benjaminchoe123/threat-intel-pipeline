# Secrets
.env

# Runtime data (state db, raw source snapshots, quarantine).
# Anchored: an unanchored "data/" also matched pipeline/data/, which holds the
# committed ATT&CK catalog — CI would have silently fallen back to regex-only
# technique validation.
/data/

# Logs and audit trail
/logs/

# Unapproved report drafts — never published
vault/reports/drafts/

# Upstream MISP-in-a-box, cloned locally per docs/MISP-SETUP.md — not our code
/misp/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Obsidian workspace state (keep vault content, not editor state)
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json

# Local git worktrees (superpowers:using-git-worktrees)
.worktrees/

# Subagent-driven-development scratch (progress ledger)
.superpowers/

# LinkedIn post drafts — generated marketing copy, not part of the project.
# Kept locally by pipeline.publish; a public technical repo is the wrong home for it.
vault/reports/linkedin-drafts/

# Obsidian editor state for the repo root (the vault's own .obsidian is handled above).
/.obsidian/
